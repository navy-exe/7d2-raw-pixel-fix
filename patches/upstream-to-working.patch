--- a/modules/raw_video/mlv_lite/active_7d2.h
+++ b/modules/raw_video/mlv_lite/active_7d2.h
@@ -0,0 +1,44 @@
+/* Local experimental capture path, generated with LLM assistance.
+ * Copies the measured picture region directly to a frame slot; it does not
+ * modify the Canon buffer or repack a previously captured full-width slot.
+ * Timing on the actual 7D2 must be validated before production use.
+ */
+#ifndef MLV_LITE_ACTIVE_7D2_H
+#define MLV_LITE_ACTIVE_7D2_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define ACTIVE_7D2_LEFT 144
+#define ACTIVE_7D2_RIGHT 1976
+#define ACTIVE_7D2_WIDTH (ACTIVE_7D2_RIGHT - ACTIVE_7D2_LEFT)
+#define ACTIVE_7D2_SOURCE_PITCH 3472
+#define ACTIVE_7D2_PITCH (ACTIVE_7D2_WIDTH * 14 / 8)
+
+/* Source and destination are distinct, live allocations owned by the recorder.
+ * Explicit capacities permit the host test to check the same bounds as capture.
+ * Even horizontal/vertical offsets retain the RGGB Bayer phase.
+ */
+static inline int active_7d2_copy(void *dst, size_t dst_bytes,
+                                const void *src, size_t src_bytes,
+                                int source_height, int y, int height)
+{
+    if (!dst || !src || dst == src || source_height <= 0 ||
+        source_height > 4096 || y < 0 || height <= 0 || (y & 1) ||
+        (height & 7) || y > source_height || height > source_height - y ||
+        src_bytes < (size_t) source_height * ACTIVE_7D2_SOURCE_PITCH ||
+        dst_bytes < (size_t) height * ACTIVE_7D2_PITCH)
+        return 0;
+
+    const uint8_t *in = (const uint8_t *)src +
+        (size_t)y * ACTIVE_7D2_SOURCE_PITCH + ACTIVE_7D2_LEFT * 14 / 8;
+    uint8_t *out = dst;
+    for (int row = 0; row < height; row++)
+    {
+        memcpy(out, in, ACTIVE_7D2_PITCH);
+        in += ACTIVE_7D2_SOURCE_PITCH;
+        out += ACTIVE_7D2_PITCH;
+    }
+    return 1;
+}
+#endif
--- a/modules/raw_video/mlv_lite/fast_probe_7d2.h
+++ b/modules/raw_video/mlv_lite/fast_probe_7d2.h
@@ -0,0 +1,88 @@
+/* Local LLM-assisted diagnostic, not an upstream contribution.
+ * Canon 7D2 1.1.2 descriptors verified from ROM, 0xfe0fef46:
+ * descriptor stride 12, destination +0, source +4, length +8.
+ * 0xfe0ff00a rejects counts above 8. No sensor buffers may be used here.
+ */
+#ifndef FAST_PROBE_7D2_H
+#define FAST_PROBE_7D2_H
+#include <stddef.h>
+#include <stdint.h>
+struct fast_7d2_segment { void *dst; const void *src; uint32_t bytes; };
+typedef int (*fast_7d2_transfer)(const struct fast_7d2_segment *, unsigned int);
+static inline int fast_7d2_overlap(uintptr_t a, size_t an, uintptr_t b, size_t bn)
+{
+    return a <= b ? b - a < an : a - b < bn;
+}
+
+/* Both allocations are caller-owned, disjoint and stable for the whole test.
+ * Source uses the real 3472-byte row spacing; destination is packed.
+ * Returns 0 only after all output bytes and both 64-byte guards match.
+ */
+static inline int fast_7d2_probe(void *dst, size_t dst_capacity,
+                               void *src, size_t src_capacity,
+                               unsigned int rows, unsigned int width,
+                               fast_7d2_transfer transfer)
+{
+    if (!dst || !src || !transfer || rows == 0 || rows > 8 ||
+        width == 0 || width > 3206 ||
+        dst_capacity < (size_t)rows * width + 128 ||
+        src_capacity < (size_t)rows * 3472 ||
+        fast_7d2_overlap((uintptr_t)src, rows * 3472,
+                         (uintptr_t)dst, rows * width + 128))
+        return -1000;
+    uint8_t *out = dst, *in = src;
+    for (size_t i = 0; i < (size_t)rows * 3472; i++)
+        in[i] = (uint8_t)(i * 37 + i / 257 + 81);
+    for (size_t i = 0; i < (size_t)rows * width + 128; i++)
+        out[i] = 0xa5;
+    struct fast_7d2_segment list[8];
+    for (unsigned int row = 0; row < rows; row++)
+    {
+        list[row].dst = out + 64 + row * width;
+        list[row].src = in + 252 + row * 3472;
+        list[row].bytes = width;
+    }
+    int rc = transfer(list, rows);
+    if (rc != 0) return rc;
+    for (unsigned int i = 0; i < 64; i++)
+        if (out[i] != 0xa5 || out[64 + rows * width + i] != 0xa5)
+            return -1001;
+    for (unsigned int row = 0; row < rows; row++)
+        for (unsigned int x = 0; x < width; x++)
+        {
+            size_t i = 252 + row * 3472 + x;
+            if (out[64 + row * width + x] != (uint8_t)(i * 37 + i / 257 + 81))
+                return -1002;
+        }
+    return 0;
+}
+/* Bounded full-frame transfer, at most 131 calls for the measured readout.
+ * No pixel processing: only selected packed 14-bit rows are transferred. */
+static inline int fast_7d2_frame(void *dst, size_t dst_capacity,
+                               const void *src, size_t src_capacity,
+                               int source_height, int y, int height,
+                               fast_7d2_transfer transfer)
+{
+    if (!dst || !src || !transfer || source_height <= 0 || source_height > 4096 ||
+        y < 0 || (y & 1) || height <= 0 || height > 1048 || (height & 7) ||
+        y > source_height || height > source_height - y ||
+        src_capacity < (size_t)source_height * 3472 ||
+        dst_capacity < (size_t)height * 3206 ||
+        fast_7d2_overlap((uintptr_t)src, src_capacity,
+                         (uintptr_t)dst, (size_t)height * 3206))
+        return -1000;
+    for (int row = 0; row < height; row += 8)
+    {
+        struct fast_7d2_segment list[8];
+        for (int i = 0; i < 8; i++)
+        {
+            list[i].dst = (uint8_t *)dst + (size_t)(row + i) * 3206;
+            list[i].src = (const uint8_t *)src + (size_t)(y + row + i) * 3472 + 252;
+            list[i].bytes = 3206;
+        }
+        int rc = transfer(list, 8);
+        if (rc != 0) return rc;
+    }
+    return 0;
+}
+#endif
--- a/modules/raw_video/mlv_lite/capture_tap_7d2.h
+++ b/modules/raw_video/mlv_lite/capture_tap_7d2.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Bounded task-context lifecycle for the 7D2.112 RAW capture-point video test.
+ * Hardware access is supplied by the caller; host tests mock only that boundary.
+ */
+#ifndef CAPTURE_TAP_7D2_H
+#define CAPTURE_TAP_7D2_H
+#include <stdint.h>
+struct capture_tap_sample_7d2 {
+    uint32_t selector, mux, pack, hw_rows, hw_size;
+    uint32_t width, height, pitch, bytes, bits, cfa, ticks;
+    int live, movie, zoom, resolution, crop, raw, h264, job;
+};
+struct capture_tap_ops_7d2 {
+    void (*sample)(struct capture_tap_sample_7d2 *);
+    int (*select_corrected)(void);
+    void (*restore)(uint32_t);
+    void (*sleep10)(void);
+};
+struct capture_tap_state_7d2 {
+    uint32_t original, expected;
+    int armed, active, fault;
+};
+static int capture_tap_geometry_7d2(const struct capture_tap_sample_7d2 *s)
+{
+    unsigned rows=(s->hw_rows&65535)+1, rows2=(s->hw_size>>16)+1;
+    if(rows2>rows)rows=rows2;
+    return s->live && s->movie && s->zoom==1 && !s->resolution && !s->crop &&
+        s->raw && !s->h264 && !s->job && s->pack==0x20 &&
+        s->width==1984 && s->height==1068 && s->pitch==3472 &&
+        s->bytes==3708096 && s->bits==14 && s->cfa==0x02010100 &&
+        (s->hw_size&65535)==3472 && rows==1068;
+}
+static int capture_tap_matches_7d2(const struct capture_tap_sample_7d2 *s,unsigned expected)
+{return capture_tap_geometry_7d2(s) && s->selector==expected && s->mux==expected;}
+static int capture_tap_wait_7d2(const struct capture_tap_ops_7d2 *ops,unsigned expected,unsigned frames)
+{
+    struct capture_tap_sample_7d2 s;ops->sample(&s);unsigned start=s.ticks;
+    for(unsigned i=0;i<100;i++){
+        ops->sample(&s);
+        if(!capture_tap_geometry_7d2(&s))return -31;
+        if(s.selector!=expected)return -32;
+        if(s.mux==expected && (unsigned)(s.ticks-start)>=frames)return 0;
+        ops->sleep10();
+    }
+    return -33;
+}
+static int capture_tap_begin_7d2(struct capture_tap_state_7d2 *state,const struct capture_tap_ops_7d2 *ops,int mode)
+{
+    struct capture_tap_sample_7d2 s;
+    if(state->armed || state->active || state->fault)return -34;
+    if(mode!=1 && mode!=2)return -35;
+    ops->sample(&s);
+    /* Never take ownership of an unexpected selector or someone else's tap. */
+    if(!capture_tap_matches_7d2(&s,14))return -36;
+    state->original=14;state->expected=mode==2?18:14;
+    if(mode==2){
+        state->armed=1; /* cleanup owns restoration even on setter failure */
+        if(ops->select_corrected())return -37;
+    }
+    int rc=capture_tap_wait_7d2(ops,state->expected,3);
+    if(!rc)state->active=1;
+    return rc;
+}
+static void capture_tap_restore_7d2(struct capture_tap_state_7d2 *state,const struct capture_tap_ops_7d2 *ops)
+{
+    state->active=0;
+    if(state->armed){ops->restore(state->original);state->armed=0;}
+}
+static int capture_tap_verify_restored_7d2(struct capture_tap_state_7d2 *state,const struct capture_tap_ops_7d2 *ops)
+{
+    int rc=capture_tap_wait_7d2(ops,state->original,2);
+    if(rc)state->fault=1; /* refuse another trial until reboot */
+    return rc;
+}
+#endif
